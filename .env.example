PORT=3000
# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_KEY_FILE_PATH=./path-to-your-service-account-key.json

# Security Credentials
# Master Secret Key must be exactly 32 bytes (256-bit) encoded in base64.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_SECRET_KEY=your-32-byte-base64-secret-key

# BigQuery Allowlist Configuration (comma-separated dataset.table)
# Example: my_dataset.transactions_qris,my_dataset.customers_summary
ALLOWLIST_TABLES=your_dataset.your_table_1,your_dataset.your_table_2

# Optional Login Credentials for Mock OAuth Flow
MOCK_USER_EMAIL=user@example.com
MOCK_USER_PASSWORD=secret-password

# Mode Autentikasi: MOCK atau OIDC
AUTH_PROVIDER=MOCK

# Konfigurasi jika AUTH_PROVIDER=OIDC
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/authorize
OIDC_TOKEN_ENDPOINT=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
OIDC_REDIRECT_URI=https://your-tunnel-domain.trycloudflare.com/oauth/callback
